# SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_ANON_KEY: Your Supabase public anon key (safe for RLS-protected client access)
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI_INSIGHTS_ENDPOINT: Optional backend proxy URL for AI spending insights
AI_INSIGHTS_ENDPOINT=https://your-project-id.supabase.co/functions/v1/ai-insights
